# Node.js 24+ required. Local simulation runs without any external credentials.
PAYMENT_PROVIDER=simulated
# Only sk_test_ keys are accepted. Never use a live key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional compatible chat-completions endpoint; missing credentials use transparent rule-based planning.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini
# Change these for any non-local use. Demo credentials are documented in README.
MANAGER_PASSWORD=
BUYER_PASSWORD=
